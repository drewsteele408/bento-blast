{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "includeGitInstructions": false,
  "permissions": {
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)"
    ]
  }
}
